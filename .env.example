# bittle-agent configuration
# Copy to .env and adjust. Defaults are the SAFE ones — read SAFETY.md before
# changing anything in the "real hardware" block.

PORT=8008

# ── Real hardware ────────────────────────────────────────────────────────
# Both of these are required to move a physical servo, and the serial device
# must ALSO be mapped into the container (see docker-compose.yml).
#
# Leaving BITTLE_CONFIRM_TOKEN empty while hardware is armed means no
# per-request confirmation is required. The service logs a warning at startup.
BITTLE_ALLOW_REAL_HARDWARE=false
BITTLE_CONFIRM_TOKEN=
BITTLE_SERIAL_PORT=/dev/ttyUSB0
BITTLE_SERIAL_BAUD=115200

# Set false to refuse every gait, even with ack_locomotion.
BITTLE_ALLOW_LOCOMOTION=true

# ── Rate limiting (servo duty-cycle protection, not an API quota) ────────
BITTLE_RATE_PER_SEC=8
BITTLE_RATE_BURST=16

# ── Local GLM Agent Harness (Local/Internal GoldSpark Cluster) ────
BITTLE_LLM_API_BASE=http://10.0.0.141:8000/v1
BITTLE_LLM_MODEL=GLM-5.3-Flash-EXL3
BITTLE_LLM_API_KEY=EMPTY
BITTLE_LLM_TIMEOUT=60.0

# ── RL trainer (GPU box, trainer/service.py on :8009) ────────────────────
# Empty = training tools disabled. Point at the WSL2 PC running scripts/run_service.sh.
BITTLE_TRAINER_URL=
BITTLE_TRAINER_TIMEOUT=30.0
# One bittle_train_and_benchmark call may take this long (train + gates).
BITTLE_TRAINER_CYCLE_TIMEOUT=1800.0
# Agent turn budgets: control chat vs training campaign.
BITTLE_AGENT_MAX_TURNS=6
BITTLE_AGENT_MAX_TURNS_TRAINING=12
# Web research tools for the agent (DuckDuckGo / arXiv / page reader).
BITTLE_ALLOW_WEB_RESEARCH=true
